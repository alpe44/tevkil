# Sunucu
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4000

# PostgreSQL bağlantısı
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tevkil_agi

# JWT
JWT_SECRET=degistir-bu-cok-uzun-ve-rastgele-bir-deger-olmali
JWT_EXPIRES_IN=7d

# İlk admin hesabı (migrate sonrası opsiyonel seed için)
ADMIN_EMAIL=admin@tevkil-agi.local
ADMIN_PASSWORD=DegistirBu123!

# Uygulamanın herkese açık adresi (e-posta içindeki linkler için, örn. şifre sıfırlama)
APP_BASE_URL=http://localhost:4000

# SMTP (opsiyonel). Boş bırakılırsa e-postalar gerçekten gönderilmez, konsola yazdırılır.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nöbetçi <bildirim@tevkil-agi.local>
